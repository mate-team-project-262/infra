# ==============================================================================
# Production Environment Variables Template (Team 262 - Movie Match)
# Copy this file to .env on the AWS EC2 server and set strong passwords!
# ==============================================================================

# MySQL Database Credentials
MYSQL_DATABASE=moviematch_db
MYSQL_USER=moviematch_user
MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# Docker Images (Local tags or GitHub Container Registry)
FRONTEND_IMAGE=ghcr.io/mate-team-project-262/frontend:latest
BACKEND_IMAGE=ghcr.io/mate-team-project-262/backend:latest

# Application & External API Configuration (TMDB)
ROOM_MAX_PARTICIPANTS=5
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_API_KEY=CHANGE_ME_TMDB_API_KEY