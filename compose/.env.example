# ==============================================================================
# Production Environment Variables Template (Team 262 - Movie Match)
# Copy this file to .env on the AWS EC2 server and set strong passwords!
# ==============================================================================

# Compose Profile Control:
# Keep 'COMPOSE_PROFILES=local' for local development/QA (starts local MySQL container).
# Leave empty or remove on AWS EC2 production (uses external AWS RDS instead).
COMPOSE_PROFILES=local

# Database Configuration:
# - Local mode: MYSQL_HOST=mysql
# - AWS RDS mode: MYSQL_HOST=your-rds-instance.xxxx.eu-central-1.rds.amazonaws.com
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=moviematch
MYSQL_USER=moviematch_admin
MYSQL_PASSWORD=local_dev_password
MYSQL_ROOT_PASSWORD=local_root_password

# Docker Images (Local build tags or GHCR production images)
FRONTEND_IMAGE=team262-frontend:local
BACKEND_IMAGE=team262-backend:local

# Application & External API Configuration (TMDB)
ROOM_MAX_PARTICIPANTS=5
TITLE_SOURCE=stub
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_API_KEY=CHANGE_ME_TMDB_API_KEY

# Gateway profile (nginx.local.conf for localhost; leave blank or unset on Prod EC2)
NGINX_CONF_FILE=nginx.local.conf

# Allowed Frontend Origins for CORS (comma-separated)
FRONTEND_ORIGINS=https://what2watch.duckdns.org,http://localhost:5173,http://localhost